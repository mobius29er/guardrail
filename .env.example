# ---------------------------------------------------------------------------
# Halligan — example environment file
#
# Copy to `.env` and fill in only the providers you actually use:
#
#     cp .env.example .env
#
# `.env` is gitignored. NEVER put real keys in this file (.env.example IS
# committed). If you believe a key has been committed, revoke it at the
# provider first, then rewrite history — see SECURITY.md.
# ---------------------------------------------------------------------------

# --- Anthropic (Claude) ----------------------------------------------------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- OpenAI ----------------------------------------------------------------
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional: point at an OpenAI-compatible gateway (Together, Groq, vLLM, ...)
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Google Gemini ---------------------------------------------------------
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# --- Ollama (local, usually needs no key) ----------------------------------
# OLLAMA_HOST=http://localhost:11434

# --- Generic HTTP target ---------------------------------------------------
# For testing your own deployed assistant (e.g. a Truthly-style app).
# HALLIGAN_HTTP_URL=https://your-app.example.com/api/chat
# HALLIGAN_HTTP_TOKEN=
